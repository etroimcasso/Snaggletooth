# OS noise
.DS_Store

# Game dumps and ROM-derived content are never committed, anywhere in the tree.
# .spc song dumps are used as local validation inputs only.
*.spc
*.sfc
*.smc
*.fig

# Anything a tool produced FROM a cartridge is ROM-derived too — a disassembled
# source tree, its manifest, a render — so the scratch and build directories the
# tools write into are never committed either.
tmp/
build/
build-*/
*.wav

# Private working docs — local only, never pushed to the public remote.
docs-internal/
/CLAUDE.md

# A local convenience symlink to a cartridge library; never part of the repo.
roms
